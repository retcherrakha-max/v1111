# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/rakhaauth

# JWT — REQUIRED: generate with: openssl rand -hex 32
JWT_SECRET=
DASHBOARD_SESSION_TTL=7d
DASHBOARD_IDLE_TTL=7d
DASHBOARD_IP_BINDING_PREFIX=balanced

# Server
PORT=5050
NODE_ENV=production
APP_URL=http://localhost:5173/
# Cloudflare orange + Render: 2    Render only: 1
TRUST_PROXY=2
UPLOADS_DIR=/data/uploads
FILE_STORAGE_DIR=/data/appfiles

# ── Private Owner Dashboard (REQUIRED) ───────────────────────
ADMIN_USERNAME=rakha
# 10+ chars with upper, lower, number, symbol
ADMIN_PASSWORD=

# Optional: lock dashboard to your IPs only
# DASHBOARD_IP_ALLOWLIST=1.2.3.4,5.6.7.8

# REQUIRED in production. RSA PKCS#8 private key PEM for dashboard request/response encryption.
# Generate: openssl genrsa 2048
# Paste the full PEM (use \n for newlines in .env if single-line).
DASHBOARD_TRANSPORT_KEY=

LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

# ── SDK Security ──────────────────────────────────────────────
REQUIRE_SDK_SIGNATURE=true
REQUIRE_SDK_ENCRYPTION=true
SDK_TIMESTAMP_SKEW=30
# REQUIRED explicit true/false in production
# true = unused license keys can log in and auto-create the account (needed for key-only SDK apps)
ALLOW_KEY_AUTO_REGISTER=true
# Must stay false in production
VPN_FAIL_OPEN=false
# SDK routes: unset = /api/sdk/* + /api/q + /api/d
# true = also expose /api/handshake and /api/verify aliases
# false = only POST /api/q and GET /api/d (breaks panel-downloaded old SDKs)
# ALLOW_LEGACY_SDK=false
# REQUIRED: independent random values. Generate each separately.
SDK_MASTER_KEY=
# 5-60 minutes; default 30 minutes
SDK_HS2_TTL_SECONDS=1800

# REQUIRED in production. SHA-256 of your TLS certificate (64 hex, no colons).
# Embedded into downloaded SDKs. Comma-separate current + next pin before renewal.
# node -e "require('tls').connect({host:'auth.rakha.app',port:443,servername:'auth.rakha.app'},function(){console.log(this.getPeerCertificate().fingerprint256.replace(/:/g,'').toLowerCase());this.end()})"
SDK_SSL_PINS=

# ── Protected file delivery ───────────────────────────────────
# REQUIRED in production. Wraps sealed file/link secrets AND at-rest fields
# (license keys, usernames, app secrets, variable values) with AES-256-GCM.
# Keep this stable — rotating it makes previously sealed data unreadable.
# Generate: openssl rand -hex 32
FILE_ENCRYPTION_KEY=
FILE_MAX_BYTES=67108864
FILE_MAX_PER_APP=50
# Lifetime of a one-time download link, in seconds (15-600)
FILE_TICKET_TTL=120
# REQUIRED in production. Server-only HMAC key for file download tickets.
# MUST NOT be the same as appSecret. Generate: openssl rand -hex 32
FILE_TICKET_SECRET=
# Temporary migration switch only. Keep false in production after legacy data is sealed.
ALLOW_LEGACY_PLAINTEXT_VAULT=false

# BOT_SECRET=  (32+ chars; leave empty to disable)
# REQUIRED in production when BOT_SECRET is set:
# BOT_ALLOWED_APP_IDS=YOUR_APP_ID
# DISCORD_BOT_TOKEN=

# Security-alert channel. Client detections (debugger, tamper, …) POST here.
# https://discord.com/api/webhooks/ID/TOKEN
# DISCORD_SECURITY_WEBHOOK=

# ── Logging & Maintenance ─────────────────────────────────────
# How long to keep activity logs in MongoDB (days). 0 = keep forever.
LOG_RETENTION_DAYS=90
